
# Admin wallet, used to administrate the perp program (Funding, Market Setups, Glogal Config)
PROTOCOL_ADMIN=

# --- scripts/ts/*.ts config (see scripts/ts/common.ts) ---
# Path to the keypair used as payer/authority/trader in the scripts. Defaults to
# ~/.config/solana/id.json if unset.
ANCHOR_WALLET=

# Devnet RPC endpoint.
RPC_URL=https://api.devnet.solana.com

# Devnet USDC mint used by both perp and liquidity-pool (Circle's devnet USDC).
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Pyth feed id (hex, no 0x prefix) and the devnet price-feed account that
# publishes it. Pyth's own devnet infra refreshes this periodically; see
# waitForFreshOracle() in common.ts.
PYTH_FEED_ID_HEX=e62df6c8b4a85fe1a67db44dc12de5db330f7ac66b72dc658afedf0f4a415b43
PYTH_PRICE_FEED_ACCOUNT=4cSM2e6rvbGQUFiJbqytoVMi5GgghSMr8LwVrT9VPSPo

# Wallet that receives protocol fees (must be distinct from the trader wallet
# above — see the comment on FEE_RECEIVER in common.ts).
FEE_RECEIVER=8ab1ytf1MV5h7UF23ntqrSbHpFh6FY5ma3pLHghCJCwz

# Symbol for the test market the scripts create/use.
MARKET_SYMBOL=TESTUSD