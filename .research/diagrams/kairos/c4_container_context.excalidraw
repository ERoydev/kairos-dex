    {
      "id": "aX5ZgsuWzY1DVKog85ofY",
      "type": "text",
      "x": -1841.6011439732133,
      "y": 695.9136904761908,
      "width": 1062.5435791015625,
      "height": 216.653645833333,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
