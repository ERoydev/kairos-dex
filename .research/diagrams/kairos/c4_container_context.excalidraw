      "seed": 1720429894,
      "version": 788,
      "versionNonce": 1365235226,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787095192778,
      "link": null,
      "locked": false,
      "text": "1. Liquidation bot — watches positions, calls liquidate when equity < MMR threshold. \n    Permissionless (anyone can run it, gets keeper reward).\n\n2. Funding tick bot — calls update_funding every interval_seconds (e.g., hourly). Also permissionless.\n\nSo this bot handles both of these processes in one service, \nso everyone can participate and win rewards by using our bot client.\n",
      "fontSize": 21.6653645833333,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Liquidation bot — watches positions, calls liquidate when equity < MMR threshold. \n    Permissionless (anyone can run it, gets keeper reward).\n\n2. Funding tick bot — calls update_funding every interval_seconds (e.g., hourly). Also permissionless.\n\nSo this bot handles both of these processes in one service, \nso everyone can participate and win rewards by using our bot client.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
