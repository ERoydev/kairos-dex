# Solana RPC endpoint (devnet/mainnet). Use a dedicated provider in production —
# getProgramAccounts scans get slow on public RPC as position count grows.
RPC_URL=https://api.devnet.solana.com

# Same Postgres instance kairos-indexer writes to. The keeper reads cached market state
# (oi, last_funding_time, interval_seconds) from here instead of hitting RPC on every tick.
DATABASE_URL=postgres://<user>:<password>@localhost:<port>/<db>

# Deployed perp program to watch (see ../.docs/Deployments.md)
PERP_PROGRAM_ID=FWmruxC6TfBGZyXbQtzNjjJVrYMzRWLsTr6iscs9bkyK

# USDC mint used by every market's vaults/ATAs
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Keeper signer — funds both loops' tx fees and receives the liquidation reward.
# Provide exactly one of these.
KEEPER_KEYPAIR_PATH=/path/to/keeper-keypair.json
# KEEPER_KEYPAIR_SECRET=base58-encoded-secret-key


# How often the liquidation loop scans for undercollateralized positions, in seconds. Purely
# a reaction-speed-vs-RPC-load tradeoff — there's no on-chain interval to sync with.
LIQUIDATION_POLL_INTERVAL_SECS=5

# No FUNDING_POLL_INTERVAL_SECS: the funding loop derives its own poll cadence each cycle
# from the tightest `funding_config.interval_seconds` among currently deployed markets
# (that on-chain value, not this file, is what gates `update_funding`).
