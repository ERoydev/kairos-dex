# Helius endpoints (devnet)
HELIUS_API_KEY=API_KEY
HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
HELIUS_WS_URL=wss://devnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}


# Program IDs are read from ../programs/deployed_programs.json (devnet), not from here

# This is the production instance or my localhost created one with Docker
DATABASE_URL=postgres://<user>:<password>@localhost:<port>/<db>
